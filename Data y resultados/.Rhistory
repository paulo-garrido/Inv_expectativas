trayectoria_M3$banda_inferior,
trayectoria_M3$pi_estrella_li_95,
na.rm = TRUE
)
),
ceiling(
max(
trayectoria_M3$banda_superior,
trayectoria_M3$pi_estrella_ls_95,
na.rm = TRUE
)
),
by = 1
),
expand = ggplot2::expansion(
mult = c(0.03, 0.05)
)
) +
ggplot2::labs(
x = NULL,
y = "Porcentaje",
colour = NULL,
linetype = NULL
) +
tema_wp +
ggplot2::theme(
legend.position = "bottom",
legend.box = "horizontal"
)
ggplot2::ggsave(
file.path(
carpeta_salida,
"figura_04_ancla_implicita.png"
),
plot = p_ancla,
width = 8.5,
height = 4.3,
dpi = 300,
bg = "white"
)
print(p_ancla)
