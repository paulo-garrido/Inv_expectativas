H = H,
Q_c0 = Q_diag[1],
Q_c = Q_diag[2],
p_LB_expectativas_12 =
lb12,
lambda_promedio =
mean(
lambda,
na.rm = TRUE
),
lambda_inicial =
dplyr::first(
lambda[
is.finite(lambda)
]
),
lambda_final =
dplyr::last(
lambda[
is.finite(lambda)
]
),
lambda_min =
min(
lambda,
na.rm = TRUE
),
lambda_max =
max(
lambda,
na.rm = TRUE
),
porcentaje_lambda_0_1 =
100 *
mean(
lambda >= 0 &
lambda <= 1,
na.rm = TRUE
)
)
list(
trayectoria = trayectoria,
resumen = resumen
)
}
resultados_tvp <- list()
for (variable in medidas_tvp) {
message(
"Estimando TVP condicional con: ",
variable
)
resultados_tvp[[variable]] <- tryCatch(
estimar_tvp_condicional(
datos,
variable
),
error = function(e) {
warning(
"No se estimó ",
variable,
": ",
conditionMessage(e)
)
NULL
}
)
}
resultados_tvp <- Filter(
Negate(is.null),
resultados_tvp
)
if (length(resultados_tvp) > 0L) {
tabla_resumen_tvp <- dplyr::bind_rows(
unname(
lapply(
resultados_tvp,
function(x) x$resumen
)
)
)
tabla_trayectorias_tvp <- dplyr::bind_rows(
unname(
lapply(
resultados_tvp,
function(x) x$trayectoria
)
)
)
referencia_lambda <- tabla_trayectorias_tvp |>
dplyr::filter(
variable ==
"infl_interanual_base"
) |>
dplyr::select(
fecha,
lambda_referencia =
lambda_t
)
tabla_robustez_lambda <- tabla_trayectorias_tvp |>
dplyr::left_join(
referencia_lambda,
by = "fecha"
) |>
dplyr::group_by(
variable,
medida
) |>
dplyr::summarise(
correlacion_con_base =
correlacion_segura(
lambda_t,
lambda_referencia
),
RMSE_con_base =
sqrt(
mean(
(
lambda_t -
lambda_referencia
)^2,
na.rm = TRUE
)
),
max_diferencia_con_base =
max(
abs(
lambda_t -
lambda_referencia
),
na.rm = TRUE
),
.groups = "drop"
)
tabla_resumen_tvp <- tabla_resumen_tvp |>
dplyr::left_join(
tabla_robustez_lambda,
by = c(
"variable",
"medida"
)
)
guardar_csv_seguro(
tabla_resumen_tvp,
file.path(
carpeta_salida,
"05_resumen_TVP_condicional_por_medida.csv"
)
)
guardar_csv_seguro(
tabla_trayectorias_tvp,
file.path(
carpeta_salida,
"06_trayectorias_TVP_condicional.csv"
)
)
}
# 8. GRÁFICAS -----------------------------------------------------------------
datos_largos <- datos |>
dplyr::select(
fecha,
dplyr::all_of(
medidas_todas
)
) |>
tidyr::pivot_longer(
cols = -fecha,
names_to = "variable",
values_to = "inflacion"
) |>
dplyr::mutate(
medida =
unname(
etiquetas_medidas[variable]
)
)
p_medidas <- ggplot2::ggplot(
datos_largos,
ggplot2::aes(
x = fecha,
y = inflacion
)
) +
ggplot2::geom_line(
linewidth = 0.5
) +
ggplot2::facet_wrap(
~medida,
scales = "free_y",
ncol = 2
) +
ggplot2::labs(
title =
"Medidas alternativas de inflación",
subtitle =
"Inflación interanual, mensual y trimestral anualizada",
x = NULL,
y = "Porcentaje"
) +
ggplot2::theme_minimal(
base_size = 11
)
ggplot2::ggsave(
filename = file.path(
carpeta_salida,
"07_medidas_alternativas_inflacion.png"
),
plot = p_medidas,
width = 11,
height = 10,
dpi = 300
)
p_persistencia <- tabla_persistencia |>
dplyr::select(
medida,
autocorrelacion_lag1,
autocorrelacion_lag4,
autocorrelacion_lag12
) |>
tidyr::pivot_longer(
cols = -medida,
names_to = "rezago",
values_to = "autocorrelacion"
) |>
ggplot2::ggplot(
ggplot2::aes(
x = medida,
y = autocorrelacion,
shape = rezago
)
) +
ggplot2::geom_point(
size = 3
) +
ggplot2::coord_flip() +
ggplot2::labs(
title =
"Persistencia de las medidas de inflación",
x = NULL,
y = "Autocorrelación",
shape = NULL
) +
ggplot2::theme_minimal(
base_size = 11
)
ggplot2::ggsave(
filename = file.path(
carpeta_salida,
"08_persistencia_medidas_inflacion.png"
),
plot = p_persistencia,
width = 9,
height = 6,
dpi = 300
)
p_ljung <- tabla_ljung_box |>
dplyr::filter(
rezago == 12L
) |>
ggplot2::ggplot(
ggplot2::aes(
x = medida,
y = p_LB,
shape = especificacion
)
) +
ggplot2::geom_hline(
yintercept = 0.05,
linetype = "dashed"
) +
ggplot2::geom_point(
size = 3
) +
ggplot2::coord_flip() +
ggplot2::labs(
title =
"Autocorrelación residual según medida de inflación",
subtitle =
"Valor p de Ljung-Box a doce rezagos",
x = NULL,
y = "Valor p",
shape = NULL
) +
ggplot2::theme_minimal(
base_size = 11
)
ggplot2::ggsave(
filename = file.path(
carpeta_salida,
"09_ljung_box_medidas_inflacion.png"
),
plot = p_ljung,
width = 9,
height = 6,
dpi = 300
)
if (
exists(
"tabla_trayectorias_tvp"
)
) {
p_lambda <- ggplot2::ggplot(
tabla_trayectorias_tvp,
ggplot2::aes(
x = fecha,
y = lambda_t,
linetype = medida
)
) +
ggplot2::geom_line(
linewidth = 0.7
) +
ggplot2::geom_hline(
yintercept = 1,
linetype = "dashed"
) +
ggplot2::labs(
title =
"Proxy condicional de credibilidad por medida de inflación",
x = NULL,
y = expression(lambda[t]),
linetype = NULL
) +
ggplot2::theme_minimal(
base_size = 11
) +
ggplot2::theme(
legend.position = "bottom"
)
ggplot2::ggsave(
filename = file.path(
carpeta_salida,
"10_lambda_por_medida_inflacion.png"
),
plot = p_lambda,
width = 11,
height = 7,
dpi = 300
)
}
# 9. RESUMEN EJECUTIVO --------------------------------------------------------
mejor_diagnostico <- tabla_modelos_inflacion |>
dplyr::filter(
is.finite(
p_LB_12
)
) |>
dplyr::slice_max(
p_LB_12,
n = 1,
with_ties = FALSE
)
medidas_sin_autocorrelacion <- tabla_modelos_inflacion |>
dplyr::filter(
is.finite(
p_LB_12
),
p_LB_12 >= 0.05
)
lineas <- c(
"",
"======================================================================",
"PRUEBAS CON MEDIDAS ALTERNATIVAS DE INFLACIÓN",
"======================================================================",
paste0(
"Archivo base: ",
archivo_base
),
paste0(
"Archivo IPC/subyacente: ",
archivo_inflacion
),
paste0(
"Muestra base: ",
format(
min(datos$fecha),
"%Y-%m"
),
" a ",
format(
max(datos$fecha),
"%Y-%m"
)
),
paste0(
"Observaciones de la base: ",
nrow(datos)
),
"",
"MEDIDAS CONSTRUIDAS",
"1. Inflación interanual original.",
"2. Inflación interanual calculada desde el IPC.",
"3. Inflación mensual desestacionalizada.",
"4. Inflación mensual desestacionalizada anualizada.",
"5. Inflación de tres meses desestacionalizada anualizada.",
"6. Inflación subyacente interanual.",
"",
"DIAGNÓSTICO DE AUTOCORRELACIÓN",
paste0(
"Mejor p-Ljung-Box(12): ",
mejor_diagnostico$medida,
" | ",
mejor_diagnostico$especificacion,
" | p = ",
formato_cientifico(
mejor_diagnostico$p_LB_12
)
),
paste0(
"Número de especificaciones con p-LB(12) >= 0.05: ",
nrow(
medidas_sin_autocorrelacion
)
),
if (
nrow(
medidas_sin_autocorrelacion
) > 0L
) {
paste0(
"Especificaciones sin autocorrelación significativa: ",
paste(
paste0(
medidas_sin_autocorrelacion$medida,
" [",
medidas_sin_autocorrelacion$especificacion,
"]"
),
collapse = "; "
)
)
} else {
paste(
"Ninguna medida elimina completamente la autocorrelación",
"a doce rezagos."
)
},
"",
"MODELO TVP CONDICIONAL",
if (
exists(
"tabla_resumen_tvp"
)
) {
paste0(
"Medidas TVP estimadas: ",
nrow(
tabla_resumen_tvp
)
)
} else {
"No se estimó ninguna especificación TVP."
},
if (
exists(
"tabla_resumen_tvp"
)
) {
paste0(
"Mayor correlación de lambda con la inflación base: ",
tabla_resumen_tvp$medida[
which.max(
tabla_resumen_tvp$
correlacion_con_base
)
],
" | corr = ",
formato_num(
max(
tabla_resumen_tvp$
correlacion_con_base,
na.rm = TRUE
)
)
)
} else {
""
},
"",
"NOTA DE INTERPRETACIÓN",
paste(
"AIC y BIC deben compararse dentro de cada medida de inflación,",
"no entre medidas con escalas diferentes."
),
paste(
"La inflación mensual no anualizada no se utiliza para lambda_t",
"porque no está en la misma escala anual de la expectativa a 24 meses."
),
paste(
"El ajuste estacional mediante STL es diagnóstico y no sustituye",
"una serie oficial desestacionalizada."
),
"",
paste0(
"Resultados guardados en: ",
carpeta_salida
),
"======================================================================"
)
writeLines(
lineas,
file.path(
carpeta_salida,
"00_resumen_ejecutivo.txt"
)
)
cat(
paste(
lineas,
collapse = "\n"
),
"\n"
)
